</main>
<script>
(() => {
  'use strict';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cover = document.getElementById('cover');
  const main = document.getElementById('invitation-content');
  const openBtn = document.getElementById('openBtn');

  // Lock scrolling only while the opening screen is active.
  document.body.classList.add('lock');

  const revealElements = document.querySelectorAll('.rv');

  const revealAll = () => revealElements.forEach(el => el.classList.add('in'));

  if ('IntersectionObserver' in window && !reduceMotion) {
    const io = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, {threshold:0.08, rootMargin:'0px 0px -8% 0px'});
    revealElements.forEach(el => io.observe(el));
  } else {
    revealAll();
  }

  const openInvitation = () => {
    if (!cover || !openBtn) return;
    cover.classList.add('open');
    document.body.classList.remove('lock');
    if (main) {
      main.removeAttribute('inert');
      main.focus({preventScroll:true});
    }

    const finish = () => {
      cover.classList.add('gone');
      cover.setAttribute('aria-hidden','true');
      openBtn.blur();
      window.scrollTo(0,0);
    };

    if (reduceMotion) finish();
    else window.setTimeout(finish, 920);

    window.setTimeout(() => {
      const hero = document.querySelectorAll('main section:first-of-type .rv');
      hero.forEach(el => el.classList.add('in'));
    }, reduceMotion ? 0 : 250);
  };

  if (openBtn) openBtn.addEventListener('click', openInvitation);

  // Escape closes the invitation cover too, which is useful for keyboard users.
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && cover && !cover.classList.contains('gone')) openInvitation();
  });

  // Decorative particles are deliberately disabled on small/low-power environments.
  const dustContainer = document.getElementById('gold-dust');
  const smallScreen = window.matchMedia('(max-width: 600px)').matches;
  const saveData = navigator.connection && navigator.connection.saveData;
  if (dustContainer && !reduceMotion && !smallScreen && !saveData) {
    const count = 6;
    const fragment = document.createDocumentFragment();
    for (let i=0; i<count; i++) {
      const p=document.createElement('div');
      p.className='dust-particle';
      p.style.cssText =
        `--x:${Math.random()*100}%;--s:${Math.random()*2+1}px;`+
        `--t:${Math.random()*8+12}s;--dl:${Math.random()*-20}s;`+
        `--dx:${(Math.random()-.5)*60}px;--max-op:${Math.random()*.28+.08};`;
      fragment.appendChild(p);
    }
    dustContainer.appendChild(fragment);
  }

  // Countdown: 4 October 2026, 10:00 AM IST (04:30 UTC).
  const targetDate = Date.UTC(2026, 9, 4, 4, 30, 0);
  const dEl=document.getElementById('cd'), hEl=document.getElementById('ch'),
        mEl=document.getElementById('cm'), sEl=document.getElementById('cs'),
        countdown=document.getElementById('countdown-container');

  let timerId;
  const updateCountdown=()=>{
    if (!dEl || !hEl || !mEl || !sEl) return;
    const distance=targetDate-Date.now();
    if (distance<=0) {
      if (countdown) countdown.innerHTML='<p class="text-xl md:text-3xl font-serif font-light text-luxury-gold mt-8" role="status">The momentous day is here!</p>';
      if (timerId) clearInterval(timerId);
      return;
    }
    const days=Math.floor(distance/86400000);
    const hours=Math.floor((distance%86400000)/3600000);
    const minutes=Math.floor((distance%3600000)/60000);
    const seconds=Math.floor((distance%60000)/1000);
    dEl.textContent=String(days).padStart(2,'0');
    hEl.textContent=String(hours).padStart(2,'0');
    mEl.textContent=String(minutes).padStart(2,'0');
    sEl.textContent=String(seconds).padStart(2,'0');
  };
  updateCountdown();
  timerId=window.setInterval(updateCountdown,1000);

  // If the opening screen has been removed by a browser restore, make content usable.
  window.addEventListener('pageshow', () => {
    if (!cover || cover.classList.contains('gone')) {
      document.body.classList.remove('lock');
      if (main) main.removeAttribute('inert');
    }
  }, {once:true});
})();
</script>
</body>
