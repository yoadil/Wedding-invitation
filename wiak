                <div class="flex items-center justify-center gap-4 mt-6 font-sans">
                    <a href="tel:+918005635230" class="text-sm font-light hover:text-luxury-goldlight transition-colors duration-300" aria-label="Call +91 8005635230">+91 8005635230</a>
                    <span class="text-luxury-gold opacity-50">|</span>
                    <a href="tel:+919829009137" class="text-sm font-light hover:text-luxury-goldlight transition-colors duration-300" aria-label="Call +91 9829009137">+91 9829009137</a>
