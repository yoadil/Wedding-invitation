<style>

:root{
  --bg:#fcfbf8;
  --ink:#202522;
  --muted:#5f6762;
  --green:#122219;
  --green-2:#193125;
  --gold:#b8860b;
  --gold-light:#d4af37;
  --cream:#fcfbf8;
  --line:rgba(184,134,11,.28);
  --focus:#f4cf62;
  --radius:18px;
  --content:72rem;
  --gutter:clamp(18px,4vw,48px);
  --ease:cubic-bezier(.22,.61,.36,1);
  box-sizing:border-box;
  color-scheme:light;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;background:var(--bg)}
body{
  margin:0;
  min-width:280px;
  background:var(--bg);
  color:var(--ink);
  font-size:17px;
  line-height:1.65;
  text-rendering:optimizeLegibility;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  overflow-x:hidden;
}
body.lock{overflow:hidden;height:100dvh}
img,svg{max-width:100%}
button,a{ -webkit-tap-highlight-color:transparent }
button{font:inherit}
a{color:inherit}
:focus-visible{
  outline:3px solid var(--focus);
  outline-offset:4px;
}
.skip-link{
  position:fixed;
  left:16px;
  top:12px;
  z-index:1000;
  padding:10px 16px;
  border-radius:999px;
  background:#fff;
  color:var(--green);
  font:600 14px/1.2 Montserrat,system-ui,sans-serif;
  transform:translateY(-180%);
  transition:transform .2s ease;
  box-shadow:0 8px 24px rgba(0,0,0,.18);
}
.skip-link:focus{transform:translateY(0)}
.sr-only{
  position:absolute!important;width:1px!important;height:1px!important;
  padding:0!important;margin:-1px!important;overflow:hidden!important;
  clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;
}
.font-serif{font-family:"Cormorant Garamond",Georgia,serif}
.font-script{font-family:"Great Vibes","Snell Roundhand",cursive}
.font-sans{font-family:"Montserrat",system-ui,sans-serif}
.font-hindi{font-family:"Noto Sans Devanagari",system-ui,sans-serif}

main:focus{outline:none}
main section{
  position:relative;
  isolation:isolate;
  contain:layout paint;
}
main section > div{max-width:var(--content)}
main section:first-of-type,
main section:nth-of-type(2){
  min-height:min(900px,100svh);
}
.divider{
  width:min(180px,60vw);
  height:1px;
  margin:clamp(1.5rem,4vw,2.5rem) auto;
  background:linear-gradient(90deg,transparent,rgba(212,175,55,.65),transparent);
}
.divider::after{
  width:6px;height:6px;
  background:var(--gold-light);
  box-shadow:0 0 0 4px var(--bg);
}
.rv{
  opacity:0;
  transform:translate3d(0,22px,0);
  transition:opacity .65s var(--ease),transform .65s var(--ease);
  transition-delay:var(--d,0s);
}
.rv.in{opacity:1;transform:none}

#cover{
  position:fixed;
  inset:0;
  z-index:100;
  display:grid;
  place-items:center;
  overflow:hidden;
  background:var(--green);
}
.door{
  position:absolute;
  top:0;bottom:0;
  width:50%;
  background:
    radial-gradient(circle at 50% 50%,rgba(212,175,55,.08),transparent 42%),
    var(--green);
  transition:transform .9s var(--ease);
  will-change:transform;
}
.door.l{left:0;border-right:1px solid rgba(212,175,55,.22)}
.door.r{right:0;border-left:1px solid rgba(212,175,55,.22)}
.seal-wrapper{
  position:relative;
  z-index:2;
  transition:opacity .45s ease,transform .8s var(--ease);
}
.seal{
  width:min(20rem,82vw);
  min-height:min(20rem,82vw);
  aspect-ratio:1;
  padding:clamp(28px,7vw,42px);
  border-radius:50%;
  background:var(--cream);
  box-shadow:0 18px 55px rgba(0,0,0,.38),inset 0 0 0 1px rgba(212,175,55,.24);
}
.seal::before{inset:9px;border-color:rgba(184,134,11,.8)}
.seal::after{inset:-12px}
#cover.open .door.l{transform:translate3d(-100%,0,0)}
#cover.open .door.r{transform:translate3d(100%,0,0)}
#cover.open .seal-wrapper{
  opacity:0;
  transform:scale(.82) translate3d(0,-24px,0);
  pointer-events:none;
}
#cover.gone{display:none}

#openBtn{
  min-height:48px;
  padding:13px 28px;
  border:0;
  border-radius:999px;
  background:linear-gradient(135deg,#d4af37,#f3e5ab 50%,#d4af37);
  color:var(--green);
  box-shadow:0 7px 20px rgba(0,0,0,.14);
  cursor:pointer;
  transition:transform .2s ease,box-shadow .2s ease;
}
#openBtn:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(0,0,0,.2)}
#openBtn:active{transform:translateY(0)}

.card-elegant{
  background:rgba(255,255,255,.065);
  border:1px solid rgba(212,175,55,.24);
  border-radius:14px!important;
  box-shadow:0 12px 30px rgba(0,0,0,.12);
  transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
}
.card-elegant:hover{
  transform:translateY(-3px);
  border-color:rgba(212,175,55,.42);
  box-shadow:0 18px 38px rgba(0,0,0,.17);
}
.card-elegant a{
  min-height:48px;
  border-radius:999px;
}
section:nth-of-type(3) .absolute{
  pointer-events:none;
}
#count{
  min-height:100px;
}
#count > div{
  min-width:58px;
}
#count span[id^="c"]{
  font-variant-numeric:tabular-nums;
}
#gold-dust{z-index:10}
.dust-particle{will-change:transform;contain:strict}

@media (max-width:640px){
  body{font-size:16px;line-height:1.6}
  main section{
    padding-left:var(--gutter)!important;
    padding-right:var(--gutter)!important;
  }
  main section:first-of-type{padding-top:72px!important;padding-bottom:72px!important}
  main section:nth-of-type(2){padding-top:72px!important;padding-bottom:72px!important}
  main section:nth-of-type(3){padding-top:68px!important;padding-bottom:68px!important}
  main section:nth-of-type(4){padding-top:68px!important;padding-bottom:68px!important}
  main section:nth-of-type(5){padding-top:78px!important;padding-bottom:78px!important}
  .card-elegant{padding:28px 22px!important}
  .card-elegant p{max-width:42rem}
  .font-script.text-6xl,.font-script.text-7xl{font-size:clamp(3.6rem,17vw,5.2rem)!important}
  #count{gap:8px!important}
  #count > div{min-width:54px;width:54px!important}
}
@media (min-width:641px){
  .card-elegant{min-height:100%}
}
@media (hover:none){
  .card-elegant:hover,#openBtn:hover{transform:none}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  #gold-dust,.seal::after{display:none}
  .rv{opacity:1;transform:none;transition:none}
  .door{transition-duration:.01ms}
  .seal-wrapper{transition-duration:.01ms}
  .card-elegant,#openBtn{transition:none}
}
@media (max-width:360px){
  .seal{width:88vw;min-height:88vw;padding:24px}
  #count{gap:3px!important}
  #count > div{min-width:49px;width:49px!important}
  #count .text-3xl{font-size:1.65rem!important}
}
@media (min-width:1024px){
  body{font-size:18px}
}
@media print{
  #cover,#gold-dust,.skip-link{display:none!important}
  body{background:#fff;color:#111}
  main section{break-inside:avoid;min-height:auto!important}
}

</style>
</head>
